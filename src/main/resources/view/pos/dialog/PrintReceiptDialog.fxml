<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane prefHeight="700" prefWidth="1200.0" stylesheets="@../../../styles/app.css"
   xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.swna.javafx.pos.dialog.PrintReceiptDialogController">

   <top>
      <ToolBar>
         <!-- 날짜 필터 -->
         <HBox alignment="CENTER" spacing="5">
            <DatePicker fx:id="startDatePicker" prefWidth="130" promptText="Start Date" />
            <Label text="~" />
            <DatePicker fx:id="endDatePicker" prefWidth="130" promptText="End Date" />
         </HBox>

         <Separator orientation="VERTICAL" />
         <Button fx:id="searchButton" contentDisplay="CENTER" text="Search">
            <graphic>
               <ImageView fitHeight="16" fitWidth="16" pickOnBounds="true" preserveRatio="true">
                  <Image url="@../../images/search.png" />
               </ImageView>
            </graphic>
         </Button>
         <Separator orientation="VERTICAL" />

         <Button fx:id="todayBtn" contentDisplay="CENTER" text="Today" />
         <Button fx:id="weekBtn" contentDisplay="CENTER" text="Week" />
         <Button fx:id="monthBtn" contentDisplay="CENTER" text="Month" />

         <Separator orientation="VERTICAL" />


         <Separator orientation="VERTICAL" />

         <Button fx:id="printButton" graphicTextGap="5"
            style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Print">
            <graphic>
               <Label style="-fx-text-fill: white;" text="🖨" />
            </graphic>
         </Button>

         <Separator orientation="VERTICAL" />

         <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="RECEIPT:" />
         <Label fx:id="receiptNoLabel" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;"
            text="R-20260526-001" />

         <Region HBox.hgrow="ALWAYS" />

         <Button fx:id="refreshButton" contentDisplay="CENTER" text="Refresh">
            <graphic>
               <ImageView fitHeight="16" fitWidth="16" pickOnBounds="true" preserveRatio="true">
                  <Image url="@../../images/refresh.png" />
               </ImageView>
            </graphic>
         </Button>

         <Button fx:id="closeButton" graphicTextGap="5"
            style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Close">
            <graphic>
               <Label style="-fx-text-fill: white;" text="✖" />
            </graphic>
         </Button>
      </ToolBar>
   </top>

   <center>
      <!-- 메인 수평 SplitPane -->
      <SplitPane fx:id="mainSplitPane" dividerPositions="0.4"
         style="-fx-background-color: #f0f0f0;">
         <items>
            <!-- 왼쪽: 영수증 목록 테이블 -->
            <TableView fx:id="receiptItemsTableView"
               style="-fx-background-color: white; -fx-text-fill: black;">
               <columns>
                  <TableColumn fx:id="noColumn" prefWidth="50" text="NO" />
                  <TableColumn fx:id="receiptColumn" prefWidth="180" text="RECEIPT" />
                  <TableColumn fx:id="amountColumn" prefWidth="90" text="AMOUNT" />
                  <TableColumn fx:id="discountColumn" prefWidth="90" text="D/C" />
               </columns>
            </TableView>

            <!-- 오른쪽: 수직 SplitPane (상하 구조) -->
            <SplitPane fx:id="rightSplitPane" dividerPositions="0.5" orientation="VERTICAL"
               style="-fx-background-color: #f0f0f0;">
               <items>
                  <!-- 위쪽: Sale Items TableView -->
                  <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 0;">
                     <children>
                        <!-- 요약 정보 HBox -->
                        <HBox spacing="20" style="-fx-padding: 8 10; -fx-background-color: #ecf0f1;">
                           <children>
                              <Label style="-fx-font-weight: bold;" text="Sales Summary" />
                              <Separator orientation="VERTICAL" />
                              <Label text="Date:" />
                              <Label fx:id="summaryDateLabel" style="-fx-font-weight: bold;"
                                 text="-" />
                              <Separator orientation="VERTICAL" />
                              <Label text="Total:" />
                              <Label fx:id="summaryTotalLabel"
                                 style="-fx-font-weight: bold; -fx-text-fill: #27ae60;"
                                 text="\$0.00" />
                              <Separator orientation="VERTICAL" />
                              <Label text="Discount:" />
                              <Label fx:id="summaryDiscountLabel" style="-fx-text-fill: #e74c3c;"
                                 text="\$0.00" />
                              <Separator orientation="VERTICAL" />
                              <!-- <Label text="Cash:" />
                              <Label fx:id="summaryCashLabel" text="$0.00" />
                              <Separator orientation="VERTICAL" />
                              <Label text="Credit:" />
                              <Label fx:id="summaryCreditLabel" text="\$0.00" />
                              <Separator orientation="VERTICAL" />
                              <Label text="Cashout:" />
                              <Label fx:id="summaryCashoutLabel" text="\$0.00" />
                              <Separator orientation="VERTICAL" />
                              <Label fx:id="totalCountLabel" style="-fx-text-fill: #7f8c8d;"
                                 text="Total: 0" /> -->
                           </children>
                        </HBox>
                        <TableView fx:id="saleItemsTableView" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="itemNoColumn" prefWidth="50" text="NO" />
                              <TableColumn fx:id="itemBarcodeColumn" prefWidth="120" text="BARCODE" />
                              <TableColumn fx:id="itemDescriptionColumn" prefWidth="200"
                                 text="DESCRIPTION" />
                              <TableColumn fx:id="itemQtyColumn" prefWidth="60" text="QTY" />
                              <TableColumn fx:id="itemPriceColumn" prefWidth="100" text="PRICE" />
                              <TableColumn fx:id="itemAmountColumn" prefWidth="100" text="AMOUNT" />
                              <TableColumn fx:id="itemDiscountColumn" prefWidth="80" text="D/C" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>

                  <!-- 아래쪽: 영수증 미리보기 영역 (WebView 사용) -->
                  <VBox spacing="5" style="-fx-background-color: #fafafa; -fx-padding: 0;">
                     <children>
                        <ToolBar style="-fx-background-color: #ecf0f1; -fx-padding: 5 10 5 10;">
                           <items>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"
                                 text="RECEIPT PREVIEW" />
                              <Separator orientation="VERTICAL" />
                              <Button fx:id="previewPrintButton"
                                 style="-fx-background-color: #3498db; -fx-text-fill: white;"
                                 text="Print Preview" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblStatus" style="-fx-text-fill: #7f8c8d;" text="Ready" />
                              <!-- <ProgressIndicator fx:id="progressIndicator" prefHeight="20"
                                 prefWidth="20" visible="false" /> -->
                           </items>
                        </ToolBar>

                        <!-- WebView: 실제 영수증 모양 미리보기 -->
                        <WebView fx:id="receiptWebView" prefHeight="350" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </items>
            </SplitPane>
         </items>
         <BorderPane.margin>
            <Insets bottom="7.0" left="7.0" right="7.0" top="7.0" />
         </BorderPane.margin>
      </SplitPane>
   </center>
</BorderPane>