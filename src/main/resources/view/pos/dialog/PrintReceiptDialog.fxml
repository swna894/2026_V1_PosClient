<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane prefHeight="700" prefWidth="1200.0" stylesheets="@../../../styles/app.css"
   xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.swna.javafx.pos.dialog.print_receipt_dialog.PrintReceiptDialogController">

   <top>
      <ToolBar>
         <!-- 날짜 필터 -->
         <HBox alignment="CENTER" spacing="5">
            <DatePicker fx:id="startDatePicker" prefWidth="130" promptText="Start Date" />
            <Label text="~" />
            <DatePicker fx:id="endDatePicker" prefWidth="130" promptText="End Date" />
         </HBox>

         <Separator orientation="VERTICAL" />
         <Button fx:id="searchButton" contentDisplay="CENTER" text="Search">
            <graphic>
               <ImageView fitHeight="16" fitWidth="16" pickOnBounds="true" preserveRatio="true">
               </ImageView>
            </graphic>
         </Button>
         <Separator orientation="VERTICAL" />

         <Button fx:id="todayBtn" contentDisplay="CENTER" text="Today" />
         <Button fx:id="weekBtn" contentDisplay="CENTER" text="Week" />
         <Button fx:id="monthBtn" contentDisplay="CENTER" text="Month" />

         <Separator orientation="VERTICAL" />

         <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="RECEIPT:" />
         <Label fx:id="receiptNoLabel" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;"
            text="R-20260526-001" />

         <Region HBox.hgrow="ALWAYS" />

         <Button fx:id="refreshButton" contentDisplay="CENTER" text="Refresh">
            <graphic>
               <ImageView fitHeight="16" fitWidth="16" pickOnBounds="true" preserveRatio="true">
               </ImageView>
            </graphic>
         </Button>

         <Button fx:id="closeButton" graphicTextGap="5"
            style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Close">
            <graphic>
               <Label style="-fx-text-fill: white;" text="✖" />
            </graphic>
         </Button>
      </ToolBar>
   </top>

   <center>
      <SplitPane fx:id="mainSplitPane" dividerPositions="0.37"
         style="-fx-background-color: #f0f0f0;">
         <items>
            <!-- 왼쪽: 영수증 목록 테이블 -->
            <TableView fx:id="receiptItemsTableView"
               style="-fx-background-color: white; -fx-text-fill: black;">
               <columns>
                  <TableColumn fx:id="noColumn" prefWidth="50" text="NO" />
                  <TableColumn fx:id="receiptColumn" prefWidth="180" text="RECEIPT" />
                  <TableColumn fx:id="amountColumn" prefWidth="90" text="AMOUNT" />
                  <TableColumn fx:id="discountColumn" prefWidth="90" text="D/C" />
               </columns>
            </TableView>

            <!-- 오른쪽: 수직 SplitPane -->
            <SplitPane fx:id="rightSplitPane" dividerPositions="0.5" orientation="VERTICAL"
               style="-fx-background-color: #f0f0f0;">
               <items>
                  <!-- 위쪽: Sale Items TableView -->
                  <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 0;">
                     <children>
                        <!-- Summary ToolBar (HBox로 감싸서 텍스트 잘림 방지) -->
                        <ToolBar style="-fx-background-color: #ecf0f1; -fx-padding: 3 10;">
                           <items>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                                 text="Sales Summary" />
                              <Separator orientation="VERTICAL" />

                              <!-- Date - HBox로 감쌈 -->
                              <HBox alignment="CENTER_LEFT" spacing="3" minWidth="100">
                                 <Label style="-fx-text-fill: #7f8c8d;" text="Date:" />
                                 <Label fx:id="summaryDateLabel"
                                    style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                                    text="-"
                                    minWidth="80" />
                              </HBox>
                              <Separator orientation="VERTICAL" />

                              <!-- Total - HBox로 감쌈 -->
                              <HBox alignment="CENTER_LEFT" spacing="3" minWidth="90">
                                 <Label style="-fx-text-fill: #7f8c8d;" text="Total:" />
                                 <Label fx:id="summaryTotalLabel"
                                    style="-fx-font-weight: bold; -fx-text-fill: #27ae60;"
                                    text="\$0.00"
                                    minWidth="70" />
                              </HBox>
                              <Separator orientation="VERTICAL" />

                              <!-- Cash - HBox로 감쌈 -->
                              <HBox alignment="CENTER_LEFT" spacing="3" minWidth="90">
                                 <Label style="-fx-text-fill: #7f8c8d;" text="Cash:" />
                                 <Label fx:id="summaryCashLabel"
                                    style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"
                                    text="\$0.00"
                                    minWidth="70" />
                              </HBox>
                              <Separator orientation="VERTICAL" />

                              <!-- Credit - HBox로 감쌈 -->
                              <HBox alignment="CENTER_LEFT" spacing="3" minWidth="90">
                                 <Label style="-fx-text-fill: #7f8c8d;" text="Credit:" />
                                 <Label fx:id="summaryCreditLabel"
                                    style="-fx-font-weight: bold; -fx-text-fill: #8e44ad;"
                                    text="\$0.00"
                                    minWidth="70" />
                              </HBox>
                              <Separator orientation="VERTICAL" />

                              <!-- Cashout - HBox로 감쌈 -->
                              <HBox alignment="CENTER_LEFT" spacing="3" minWidth="90">
                                 <Label style="-fx-text-fill: #7f8c8d;" text="Cashout:" />
                                 <Label fx:id="summaryCashoutLabel"
                                    style="-fx-font-weight: bold; -fx-text-fill: #e67e22;"
                                    text="\$0.00"
                                    minWidth="70" />
                              </HBox>
                              <Separator orientation="VERTICAL" />

                              <!-- Discount - HBox로 감쌈 -->
                              <HBox alignment="CENTER_LEFT" spacing="3" minWidth="90">
                                 <Label style="-fx-text-fill: #7f8c8d;" text="Discount:" />
                                 <Label fx:id="summaryDiscountLabel"
                                    style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;"
                                    text="\$0.00"
                                    minWidth="70" />
                              </HBox>
                              <Separator orientation="VERTICAL" />

                              <Region HBox.hgrow="ALWAYS" />

                              <!-- Total Count - HBox로 감쌈 -->
                              <HBox alignment="CENTER_LEFT" spacing="3" minWidth="80">
                                 <Label fx:id="totalCountLabel"
                                    style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"
                                    text="Items: 0"
                                    minWidth="70" />
                              </HBox>
                           </items>
                        </ToolBar>

                        <TableView fx:id="saleItemsTableView" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="itemNoColumn" prefWidth="50" text="NO" />
                              <TableColumn fx:id="itemBarcodeColumn" prefWidth="120" text="BARCODE" />
                              <TableColumn fx:id="itemDescriptionColumn" prefWidth="200"
                                 text="DESCRIPTION" />
                              <TableColumn fx:id="itemQtyColumn" prefWidth="60" text="QTY" />
                              <TableColumn fx:id="itemPriceColumn" prefWidth="100" text="PRICE" />
                              <TableColumn fx:id="itemAmountColumn" prefWidth="100" text="AMOUNT" />
                              <TableColumn fx:id="itemDiscountColumn" prefWidth="100" text="D/C" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>

                  <!-- 아래쪽: 영수증 미리보기 영역 -->
                  <VBox spacing="5" style="-fx-background-color: #fafafa; -fx-padding: 0;">
                     <children>
                        <ToolBar style="-fx-background-color: #ecf0f1; -fx-padding: 5 10 5 10;">
                           <items>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"
                                 text="RECEIPT PREVIEW" />
                              <Separator orientation="VERTICAL" />

                              <Button fx:id="printButton" graphicTextGap="5"
                                 style="-fx-background-color: #27ae60; -fx-text-fill: white;"
                                 text="Print">
                                 <graphic>
                                    <Label style="-fx-text-fill: white;" text="🖨" />
                                 </graphic>
                              </Button>
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblStatus" style="-fx-text-fill: #7f8c8d;" text="Ready" />
                           </items>
                        </ToolBar>

                        <WebView fx:id="receiptWebView" prefHeight="350" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </items>
            </SplitPane>
         </items>
         <BorderPane.margin>
            <Insets bottom="7.0" left="7.0" right="7.0" top="7.0" />
         </BorderPane.margin>
      </SplitPane>
   </center>
</BorderPane>