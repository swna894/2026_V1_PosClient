<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="dialog-container" stylesheets="@../../../styles/pos_dialog.css"
   xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.swna.javafx.controller.pos.dialog.ItemDiscountDialogController">

   <padding>
      <Insets bottom="25" left="30" right="30" top="25" />
   </padding>

   <VBox alignment="CENTER" spacing="5">
      <Label fx:id="lblTitle" styleClass="title-label" text="Item Discount / Change" />
      <Separator styleClass="title-separator" />
      <HBox alignment="CENTER" spacing="10">
         <Label styleClass="info-header" text="Item Code:" />
         <Label fx:id="lblItemBarcode" styleClass="info-value" text="-" />
      </HBox>
   </VBox>

   <GridPane hgap="15" vgap="15">
      <columnConstraints>
         <ColumnConstraints halignment="CENTER" minWidth="50" />
         <ColumnConstraints hgrow="ALWAYS" minWidth="150" />
         <ColumnConstraints minWidth="100" />
      </columnConstraints>

      <RadioButton fx:id="rbPrice" selected="true" GridPane.columnIndex="0" GridPane.rowIndex="0">
         <toggleGroup>
            <ToggleGroup fx:id="dcGroup" />
         </toggleGroup>
      </RadioButton>
      <Label styleClass="field-label" text="Price after DC" GridPane.columnIndex="1"
         GridPane.rowIndex="0" />
      <TextField fx:id="txtPriceAfterDC" styleClass="input-field" GridPane.columnIndex="2"
         GridPane.rowIndex="0" />

      <RadioButton fx:id="rbPercent" toggleGroup="$dcGroup" GridPane.columnIndex="0"
         GridPane.rowIndex="1" />
      <Label styleClass="field-label" text="DC By %" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <TextField fx:id="txtDiscountPercent" styleClass="input-field" GridPane.columnIndex="2"
         GridPane.rowIndex="1" />
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
   </GridPane>

   <HBox alignment="CENTER" spacing="15">
      <Button onAction="#handleConfirm" styleClass="btn-confirm" text="CONFIRM [F12]" />
      <Button onAction="#handleCancel" styleClass="btn-cancel" text="CANCEL [ESC]" />
   </HBox>
</VBox>