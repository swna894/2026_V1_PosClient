<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.newvista.unpacking.ReadExcelController"
   prefWidth="800.0" prefHeight="500.0"
   styleClass="modal-dialog-content">
   <padding>
      <Insets top="10" right="10" bottom="10" left="10" />
   </padding>

   <top>
      <VBox spacing="8" fillWidth="true">
         <!-- Top Action Toolbar Area -->
         <ToolBar fx:id="toolBarTop">
            <DatePicker fx:id="datePicker" styleClass="picker" />
            <ComboBox fx:id="comboBoxSupplier" prefWidth="250.0" promptText="Select Supplier" />
            <Pane HBox.hgrow="ALWAYS" /> <!-- Spacer -->
            <CheckBox fx:id="checkBoxSupplier" text="CHECK SUPPLIER" />
            <Button fx:id="buttonUpload" text="_Upload" styleClass="long_button" />
            <Button fx:id="buttonReload" text="_Reload" styleClass="long_button" />
            <Button fx:id="buttonBackColor" styleClass="button-small" />
         </ToolBar>

         <!-- Path & Sheet Selection Area -->
         <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="buttonPath" styleClass="button-small" text="Select excel" />
            <TextField fx:id="textFieldFilePath" HBox.hgrow="ALWAYS" minHeight="30.0" />
            <ComboBox fx:id="comboBoxSheet" prefWidth="150.0" promptText="Sheet" />
         </HBox>
      </VBox>
   </top>

   <center>
      <ListView fx:id="listViewLog">
         <BorderPane.margin>
            <Insets top="10" right="0" bottom="7" left="0" />
         </BorderPane.margin>
      </ListView>
   </center>

   <bottom>
      <Label fx:id="labelInvoice" text=" Invoice : " styleClass="label-stock" />
   </bottom>
</BorderPane>