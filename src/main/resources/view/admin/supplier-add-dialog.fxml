<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.swna.javafx.admin.supplier.SupplierAddDialogController">
   <children>
      <BorderPane maxWidth="550.0" prefWidth="550.0" style="-fx-background-color: #f4f4f4;" StackPane.alignment="CENTER">

         <!-- 상단 (Top): 타이틀, 버튼, 에러 메시지 -->
         <top>
            <VBox alignment="TOP_CENTER" spacing="12.0" BorderPane.alignment="CENTER">
               <children>
                  <Label style="-fx-text-fill: #333333; -fx-font-size: 16px; -fx-font-weight: bold;" text="NEW SUPPLIER" />

                  <!-- 검증/서버 에러 표시용 (평소에는 숨김) -->
                  <Label fx:id="lblError" managed="false" visible="false" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #c0392b; -fx-font-size: 12px;" />
               </children>
               <padding>
                  <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </top>

         <!-- 중앙 (Center): 입력 폼 -->
         <center>
            <GridPane hgap="10.0" vgap="10.0" style="-fx-background-color: #f4f4f4;">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="100.0" prefWidth="130.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="360.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <!-- 1. ABBR (필수, 대문자+숫자, 최대 8자) -->
                  <Label style="-fx-text-fill: #333333;" text="ABBR *" GridPane.rowIndex="0" />
                  <TextField fx:id="tfAbbr" promptText="2-8 chars: A-Z, 0-9, symbols" style="-fx-background-color: #ffffff; -fx-text-fill: #333333; -fx-border-color: #cccccc;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <!-- 2. NAME (필수) -->
                  <Label style="-fx-text-fill: #333333;" text="NAME *" GridPane.rowIndex="1" />
                  <TextField fx:id="tfName" style="-fx-background-color: #ffffff; -fx-text-fill: #333333; -fx-border-color: #cccccc;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <!-- 3. COMPANY -->
                  <Label style="-fx-text-fill: #333333;" text="COMPANY" GridPane.rowIndex="2" />
                  <TextField fx:id="tfCompany" style="-fx-background-color: #ffffff; -fx-text-fill: #333333; -fx-border-color: #cccccc;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <!-- 4. E-MAIL -->
                  <Label style="-fx-text-fill: #333333;" text="E-MAIL" GridPane.rowIndex="3" />
                  <TextField fx:id="tfEmail" style="-fx-background-color: #ffffff; -fx-text-fill: #333333; -fx-border-color: #cccccc;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                  <!-- 5. PHONE -->
                  <Label style="-fx-text-fill: #333333;" text="PHONE" GridPane.rowIndex="4" />
                  <TextField fx:id="tfPhone" style="-fx-background-color: #ffffff; -fx-text-fill: #333333; -fx-border-color: #cccccc;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                  <!-- 6. MOBILE PHONE -->
                  <Label style="-fx-text-fill: #333333;" text="MOBILE PHONE" GridPane.rowIndex="5" />
                  <TextField fx:id="tfCellphone" style="-fx-background-color: #ffffff; -fx-text-fill: #333333; -fx-border-color: #cccccc;" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                  <!-- 7. ADDRESS -->
                  <Label style="-fx-text-fill: #333333;" text="ADDRESS" GridPane.rowIndex="6" />
                  <TextField fx:id="tfAddress" style="-fx-background-color: #ffffff; -fx-text-fill: #333333; -fx-border-color: #cccccc;" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                  <!-- 8. ACTIVE -->
                  <Label style="-fx-text-fill: #333333;" text="ACTIVE" GridPane.rowIndex="7" />
                  <CheckBox fx:id="cbActive" mnemonicParsing="false" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="7" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="5.0" />
               </padding>
            </GridPane>
         </center>

         <!-- 하단 (Bottom): SAVE / CANCEL 버튼을 각각 50% 너비로 배치 -->
         <bottom>
            <GridPane hgap="10.0" BorderPane.alignment="CENTER">
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
               </columnConstraints>
               <children>
                  <Button fx:id="btnSave" defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSave" prefHeight="36.0" style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333; -fx-border-color: #cccccc;" text="SAVE" GridPane.columnIndex="0">
                     <graphic>
                        <ImageView fitHeight="16" fitWidth="16" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../images/save_24px.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="btnCancel" cancelButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleCancel" prefHeight="36.0" style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333; -fx-border-color: #cccccc;" text="CANCEL" GridPane.columnIndex="1">
                     <graphic>
                        <ImageView fitHeight="16" fitWidth="16" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../images/reload_24px.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
               </padding>
            </GridPane>
         </bottom>
      </BorderPane>
   </children>
</StackPane>