<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<!--
  위치: src/main/resources/fxml/backup.fxml
  - fx:controller 는 지정하지 않는다. BackupController(Spring 싱글톤)가
    FXMLLoader.setController(this) 로 직접 주입된다.
  - 스타일시트는 여기서 지정하지 않는다. (Parent 의 stylesheets 가 Scene 의 것보다
    우선순위가 높아, Scene 에 추가되는 black_mode.css 가 덮어써지지 않도록
    Java 코드에서 Scene 에 manage_style.css -> black_mode.css 순서로 추가한다.)
-->
<BorderPane fx:id="root" prefHeight="450.0" prefWidth="700.0" styleClass="modal-dialog-content"
   xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">

   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>

   <!-- 상단 버튼바 -->
   <top>
      <HBox fx:id="hBoxTop" alignment="CENTER_LEFT" prefHeight="50.0" spacing="10.0" styleClass="hBoxTop">
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="buttonBackup" text="Backup" styleClass="long_button" onAction="#onBackup" />
            <Button fx:id="buttonRestore" text="Restore" styleClass="long_button" onAction="#onRestore" />
            <Button fx:id="buttonBrowse" text=" Browse" styleClass="long_button" onAction="#onBrowse" />
            <Button fx:id="buttonDelete" text="Delete" styleClass="long_button" onAction="#onDelete" />
         </children>
      </HBox>
   </top>

   <!-- 백업 파일 표 -->
   <center>
      <TableView fx:id="tableView">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <placeholder>
            <Label text="백업 파일이 없습니다." />
         </placeholder>
         <columns>
            <TableColumn fx:id="colName" prefWidth="300.0" text="파일명" />
            <TableColumn fx:id="colDate" prefWidth="170.0" text="생성일시" />
            <TableColumn fx:id="colSize" prefWidth="100.0" style="-fx-alignment: CENTER-RIGHT;" text="크기" />
         </columns>
      </TableView>
   </center>

   <!-- 하단 상태바 -->
   <bottom>
      <Label fx:id="statusLabel" alignment="CENTER_LEFT" maxWidth="Infinity">
         <padding>
            <Insets bottom="6.0" left="10.0" right="10.0" top="6.0" />
         </padding>
      </Label>
   </bottom>
</BorderPane>