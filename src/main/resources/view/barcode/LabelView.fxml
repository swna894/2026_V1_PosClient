<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="1020.0" stylesheets="@../../styles/pos_main.css"
   xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.swna.javafx.barcode.LabelController">

   <!-- 중앙 영역: 테이블과 미리보기 분할 -->
   <center>
      <SplitPane dividerPositions="0.75" prefHeight="520.0" prefWidth="928.0">
         <items>
            <!-- 왼쪽: 상품 목록 테이블 -->
            <VBox>
               <!-- [수정 사항] TableColumn에 fx:id를 부여하고 내부 cellValueFactory 삭제 -->
               <TableView fx:id="table" styleClass="table-center-heade" VBox.vgrow="ALWAYS">
                  <columns>
                     <TableColumn fx:id="colNo" prefWidth="50.0" text="NO" />
                     <TableColumn fx:id="colCheckbox" maxWidth="1.7976931348623157E308"
                        minWidth="-1.0" prefWidth="50.0" styleClass="table-center" />
                     <TableColumn fx:id="barcodeColumn" maxWidth="1.7976931348623157E308"
                        prefWidth="150.0" text="BARCODE" />
                     <TableColumn fx:id="codeColumn" maxWidth="1.7976931348623157E308"
                        prefWidth="150.0" text="CODE" />
                     <TableColumn fx:id="supplierColumn" maxWidth="1.7976931348623157E308"
                        prefWidth="150.0" text="SUPPLIER" />
                     <TableColumn fx:id="descriptionColumn" prefWidth="500" text="DESCRIPTION" />
                     <TableColumn fx:id="priceColumn" prefWidth="100" text="PRICE" />
                  </columns>
               </TableView>
            </VBox>

            <!-- 오른쪽: 출력 미리보기 (printArea) -->
            <VBox fx:id="printArea" alignment="CENTER" spacing="20"
               style="-fx-background-color: white; -fx-border-color: #cccccc;">
               <padding>
                  <Insets bottom="20" left="20" right="20" top="20" />
               </padding>
               <Label fx:id="previewName" style="-fx-font-size: 16px; -fx-font-weight: bold;"
                  text="선택된 상품 없음" />
               <ImageView fx:id="barcodeImageView" fitHeight="100" fitWidth="200"
                  pickOnBounds="true" preserveRatio="true" />
               <Label fx:id="previewBarcodeText" style="-fx-font-family: 'Monospaced';"
                  text="000000000000" />

               <ProgressIndicator fx:id="progressIndicator" visible="false" />
               <Label fx:id="lblStatus" text="Ready" />
            </VBox>
         </items>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </padding>
      </SplitPane>
   </center>
   <top>
      <HBox alignment="CENTER_RIGHT" prefHeight="43.0" prefWidth="800.0" spacing="10"
         BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="12.0" />
         </padding>
         <ComboBox prefHeight="40.0" prefWidth="150.0" />
         <TextField prefHeight="40.0" />
         <Region maxWidth="Infinity" HBox.hgrow="ALWAYS" />
         <Button fx:id="btnGenerate" onAction="#onGenerate" prefHeight="40" prefWidth="140"
            styleClass="btn,btn-xlg" text="Generate PDF" />
         <Button fx:id="btnCancel" onAction="#onCancel" prefHeight="40" prefWidth="100"
            styleClass="btn,btn-lg" text="Cancel" />
         <Button fx:id="btnCancel1" onAction="#onCancel" prefHeight="40" prefWidth="100"
            styleClass="btn,btn-lg" text="Close" />
      </HBox>
   </top>
</BorderPane>