<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.swna.javafx.admin.sale.SalesTableController" spacing="5">

   <!-- Daily Summary Component -->
   <fx:include source="DailySummaryView.fxml" fx:id="dailySummary" />

   <TableView fx:id="salesTableView" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="noColumn" text="NO" prefWidth="50" />
         <TableColumn fx:id="receiptColumn" text="RECEIPT" prefWidth="190" />
         <TableColumn fx:id="saleAmountColumn" text="Final Amt" prefWidth="100" />
         <TableColumn fx:id="cashColumn" text="CASH" prefWidth="100" />
         <TableColumn fx:id="creditColumn" text="CREDIT" prefWidth="100" />
         <TableColumn fx:id="cashoutColumn" text="CASHOUT" prefWidth="100" />
         <TableColumn fx:id="balanceColumn" text="BALANCE" prefWidth="100" />
         <TableColumn fx:id="discountColumn" text="Disc. Amt" prefWidth="100" />
         <TableColumn fx:id="originalAmountColumn" text="Orig. Amt" prefWidth="100" />
         <TableColumn fx:id="acceptColumn" text="ACCEPT" prefWidth="120" />
         <TableColumn fx:id="dateColumn" text="DATE" prefWidth="125" />
      </columns>
   </TableView>

</VBox>